# 复制为 .env 并填入真实密钥：cp .env.example .env

# 纯文本对话用哪一家：deepseek（默认）| zai（智谱 GLM）。
# ⚠ 只影响文本链路；视觉（图片解析）永远是智谱 glm-4.6v-flashx。
# ⚠ 填了不认识的值**不报错**，会回退到 deepseek 并在日志里记一行 WARNING。
LLM_PROVIDER=deepseek

# DeepSeek 大模型 - https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=0.2

# Qdrant 向量库 - https://cloud.qdrant.io/
# 留空 QDRANT_URL 时会自动使用本地嵌入式模式（无需 Docker）
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_MODE=auto
QDRANT_COLLECTION=bid_qa
QDRANT_VECTOR_SIZE=512
QDRANT_DISTANCE=cosine

# Hugging Face（国内建议保留镜像地址）
HF_TOKEN=
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MODEL_CACHE_DIR=models

# 检索参数
TOP_K=5
RECALL_K=20
RRF_K=60
VECTOR_WEIGHT=1.0
BM25_WEIGHT=4.0
# 相关性闸门：低于阈值视为「知识库无匹配」
MIN_VECTOR_SCORE=0.72
MIN_BM25_SCORE=8.0

# 重排序（CrossEncoder 二次精排）
# CPU 上每条候选约 30~350ms，默认关闭，前端「重排序」开关可按需启用
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=10
RERANK_MAX_LENGTH=256
# 重排分数闸门：低于阈值视为「答非所问」（实测相关 ≈0.73 / 无关 ≈0.50）
MIN_RERANK_SCORE=0.55

# Agent 链路（前端唯一入口，把四个工具注册给模型自主调用）
# 允许的工具轮数，用尽后仍会强制再问一次（禁用工具）收口。
# 设为 5 是实测结果：对比类问题（「A 和 B 有什么区别」）至少要「实体A → 实体B → 各自补救」
# 四步，3 轮装不下 —— 模型会用满预算且后半程查询变粗（见 config.py 的详细记录）
AGENT_MAX_ROUNDS=5
# 单次请求来源总数上限（含预检索）。前端行内引用正则只认 1~2 位数字，别设太大。
# ⚠ 与上面的轮数是**耦合**的：开着联网时预检索就占掉 10 个，上限低于 ~15 会让工具轮静默溢出
AGENT_MAX_SOURCES=20
# 工具单次检索的条数上限
AGENT_TOOL_MAX_TOP_K=8
# 是否回传 reasoning_content。实测当前 API 传与不传都接受，保留是防御性的
AGENT_ECHO_REASONING=true

# 知识图谱（Neo4j 本地实例；Agent 的 query_knowledge_graph 工具用它）
# 留空 NEO4J_URI 即视为「不启用图谱」：问答照常可用，只是图谱工具会报告不可用
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT=60
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
# 单次图谱查询最多回传多少行明细（扇出大的标的物有 200+ 个供应商）
GRAPH_MAX_ROWS=20

# PostgreSQL（Agent 的 query_procurement_records 工具用它；入库脚本 src/database/to_postgresql.py 也读）
# 留空 POSTGRES_HOST 即视为「不启用数据库查询」：问答照常可用，只是那个工具不会注册
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=chatbot
POSTGRES_CONNECT_TIMEOUT=10
# 单条查询的超时（秒），作为 statement_timeout 在建连时设上
POSTGRES_QUERY_TIMEOUT=8.0
# 单次查询最多展示多少行明细（总数另用 count(*) 精确统计）
PG_MAX_ROWS=20

# 智谱视觉模型（前端的图片附件用它做结构化解析）
# 留空 ZHIPU_API_KEY 即视为「不启用图片解析」：问答照常可用，只是附件按钮会如实报错。
# 同一个 Key 也被 batch/run_batch.py 用于批量文本任务。申请：https://open.bigmodel.cn/
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ⚠ glm-4.6v-flashx 是付费档（识一张图约 0.001 元）；免费档是 glm-4.6v-flash，撞限额时改这里
ZHIPU_VISION_MODEL=glm-4.6v-flashx
ZHIPU_VISION_TIMEOUT=60.0
# 思维链 + 结构化 JSON 的余量。别照文本问答的 2048 抄——推理型模型的思维链会先吃掉它
ZHIPU_VISION_MAX_TOKENS=4096
# 单张图片字节上限（前端用同一个数做预检）
VISION_MAX_IMAGE_BYTES=10485760

# 智谱**纯文本**对话（只在 LLM_PROVIDER=zai 时生效）
# 与上面视觉那几项共用 ZHIPU_API_KEY / ZHIPU_BASE_URL，但各建各的连接。
# 前缀是 zhipu_ 而不是 zai_：新建前缀会让老 .env 里的键被静默丢弃。
ZHIPU_CHAT_MODEL=glm-4.7-flashx
ZHIPU_CHAT_TEMPERATURE=0.2
ZHIPU_CHAT_MAX_TOKENS=2048

# 本地推理 vLLM / Ollama（同样走 OpenAI 兼容协议，见 clients/local_client.py）
# ⚠⚠ **留空即为关** —— 与上面「配了 Key 即为开」不同，本地服务不看 Key 而看地址。
#   默认空 ⇒ 没跑本地服务的机器上，这两个供应商根本不出现在前端那个胶囊里。
# ⚠ 地址要带 /v1 后缀。vLLM 示例：http://127.0.0.1:8001/v1（⚠ 别用 8000，那是后端占的）
VLLM_BASE_URL=
# 必须与 `vllm serve --served-model-name` 逐字一致，否则 404 model not found
VLLM_MODEL=DeepSeek-R1-0528-Qwen3-8B
VLLM_TEMPERATURE=0.6
# ⚠ R1 的思维链会先吃掉预算，给 2048 的表现是「想了半天然后返回空」
VLLM_MAX_TOKENS=8192

# Ollama 示例：http://127.0.0.1:11434/v1（跑在 CPU 上，显存留给 vLLM）
OLLAMA_BASE_URL=
# ⚠ 必须与 `ollama list` 里那个名字**逐字一致**（`<name>:<tag>` 的冒号，
#   以及 tag 本身）：写错的话服务端回 404 model not found ——
#   而那看起来像「Ollama 没起来」。
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TEMPERATURE=0.6
OLLAMA_MAX_TOKENS=4096
# ⚠⚠ **保守起点，不是结论 —— 判据只能实测**：`ollama show <模型>` 看 Capabilities
#   那行有没有 `tools`。
#   保持 false ⇒ 选 Ollama 时不挂工具、走「预检索 + 直接作答」：
#   **法规类问题照答，图谱/数据库类答不了**（工具确实没挂）。
#   ⚠ 不降级的话，官方 deepseek-r1:8b 那种「模板里没有 tools 段」的模型会被服务端
#   直接拒掉（`... does not support tools`），而 /api/agent 每轮必定带 tools
#   ⇒ 「选 Ollama 提问」一个字都出不来。
#   ⚠⚠ 但 `ollama show` 说有 `tools` **不等于调用一定跑得通**（Ollama 侧对
#   Qwen3.5 的解析器有争议，见 clients/local_client.py 那段注释）——
#   拨成 true 之后务必用 `scripts/probe_tools.py` 真机验一遍。
OLLAMA_SUPPORTS_TOOLS=false

# 联网搜索（开关打开就**必定**联网 + Agent 额外注册可主动调用的 search_web 工具）
# ⚠ 语义是「开关打开 ⇒ 每次提问都搜」，不是「本地答不出才搜」：先本地检索，再拿原问题
#   搜一次，两份结果一起进【资料】作答。本地答得出也照搜（每轮 1 credit）。
# 留空 TAVILY_API_KEY 即视为「不启用联网搜索」：工具不注册、提示词不提，问答照常。
# 申请：https://tavily.com（免费档 1000 credits/月，basic 深度每次 1 credit）
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
# basic = 1 credit/次，advanced = 2。先用 basic，实测不够再调。
TAVILY_SEARCH_DEPTH=basic
# 单次联网最多取几条。**这个值同时是上限**（模型在工具参数里要更多也会被夹到它）。
# 别调太大：本地 top_k 5 条 + 这几条会在**任何工具轮之前**先占掉 AGENT_MAX_SOURCES
# （默认 12）的额度，留给模型后续检索/联网的只剩个位数。
TAVILY_MAX_RESULTS=5
# 单次联网总超时（秒）。联网卡在 SSE 关键路径上（两条链路都得等它回来才生成），别给大。
# 连接超时另在 web_search.py 里收到 3 秒——黑洞主机 3 秒就死。
TAVILY_TIMEOUT=8.0
# 一次搜索的**准入线**：这批结果的 top 分低于它 => 整批丢弃（= 网上没这个东西）。
# **0 = 不筛**。⚠ 判据是 **top 分**、不是逐行分数——Tavily 的分随查询浮动，
# 逐行绝对阈值会把「排第 3 但真相关」的那条误杀。
# 0.70 是 2026-09-20 复标的：答得出的 top 分 0.7863~0.9077，
# 网上没答案的 0.093~0.6594，0.70 取在这条空带里。
# 依据与取舍见 config.py 的同名字段注释。
# ⚠ 换搜索深度或 Tavily 改了打分口径后要重测（跑 probe_web_search.py ⑪ 看分布）。
WEB_SEARCH_MIN_SCORE=0.70
# 逗号分隔的域名白名单（如 gov.cn,ccgp.gov.cn）。留空 = 不限。
# ⚠ 必须写成逗号分隔的**一行**，不能写成 JSON 数组（写成 list 会让服务起不来）。
WEB_SEARCH_DOMAINS=
# 单条网页内容进 Source / 提示词的长度上限（字符）。
# ⚠ 不截断是静默故障：这个串会进前端 localStorage，超配额是静默失败。
WEB_CONTENT_MAX_CHARS=400

# ---------------------------------------------------------------- Exa 备用搜索引擎
# Agent 联网的**备选引擎**：search_web（Tavily）返回 0 条或明显答非所问时，
# 模型可以换个引擎、用**同一个查询词**再搜一次。
# ⚠⚠ 它与 Tavily 是**三个条件同时为真才挂出去**：用户这次开了「联网搜索」开关
#     ∧ TAVILY_API_KEY 非空 ∧ EXA_API_KEY 非空。Exa 每次调用**都花钱**，
#     用户没开联网开关就偷偷挂出去 = 未经同意扣费，所以它跟着那个开关走。
# 留空 EXA_API_KEY 即视为「不用 Exa」：工具不注册、提示词不提，Tavily 完全不受影响。
# 申请：https://exa.ai —— 托管 MCP 端点，走 MCP 协议（streamable HTTP）。
EXA_API_KEY=
# 托管 MCP 端点。⚠ `?tools=` 是**替换**语义（不是追加）：列出来的就是暴露的那几个工具。
# 改这个 URL 前先确认目标端点仍提供 web_search_advanced_exa 这个名字。
EXA_MCP_URL=https://mcp.exa.ai/mcp?tools=web_search_advanced_exa
# 单次 Exa 搜索最多取几条。**同时是上限**（模型要更多会被夹到它）。
EXA_MAX_RESULTS=5
# 单次调用的总超时（秒）。MCP 每次调用**现连现断**（握手约 0.2s + initialize 0.6s），
# 实测一次完整搜索约 6.7s、最长见过 10.3s —— 20 是留了余量的。
# ⚠ 与联网一样卡在 SSE 关键路径上，别给大。
EXA_TIMEOUT=20.0
# 一次 Exa 搜索的准入线（与 WEB_SEARCH_MIN_SCORE 同形）。
# ⚠⚠⚠ **默认 0 = 不筛，而且现在也只能是 0**：Exa 返回的结果里**根本没有 score 字段**
#    （实测只有 id/url/title/text + 可选的 author/publishedDate/image/favicon），
#    所以「拿 top 分跟阈值比」这件事在这里没有判据可用。写成非 0 也不会静默丢空整批
#    —— `web_search_exa.to_sources()` 有一条守卫：一行都没带分数时就跳过闸门并记 WARNING。
# ⚠ 真要标定它，前提是先量到一份真实分布，而那需要 Exa 先给出分数。别凭空填个数。
EXA_MIN_SCORE=0.0

# ---------------------------------------------------------------- 自建 MCP 服务器
# 我们**自己写的** MCP 服务（`python -m bidding_qa.mcp_server`，默认只绑 127.0.0.1:8765）
# 把三个工具暴露出去：search_knowledge_graph / search_procurement_records / load_skill。
# 后端在这里填上它的地址之后，那三个工具就**经 MCP 走独立进程**去执行，
# 而不是在本进程里直接调 graph_store / pg_store / skill_store。
#
# ⚠⚠ 留空是**默认且健康**的状态，不是「没配好」：
#    空   = 三个工具在本进程内执行（与加这个功能之前逐字节相同）
#    非空 = 那三个工具经 MCP 执行；服务器没起时会**如实报失败**（错误文本里带这个地址），
#           **不会**悄悄退回进程内 —— 所以「工具突然全挂」时先看这个 URL 指向的进程在不在。
# 注意它是**我们自己的回环服务、不需要任何凭据**（与上面 EXA_MCP_URL 那个托管端点不同）。
# 服务器进程与后端必须读**同一份 .env**（config.py 里的 env_file 是绝对路径，天然成立）。
# 起服务器：uv run python -m bidding_qa.mcp_server
# ⚠ 只在本机用时别改这里绑到 0.0.0.0：本服务**没有任何认证**，绑定所有网卡 = 局域网内
#   任何机器都能调这三个工具（与 API_HOST 那条是同一个教训）。
MCP_SERVER_URL=

# 数据与索引
DATA_FILE=data/processed/问题答案样例数据.xlsx
INDEX_DIR=data/index
# 是否丢弃「仅标点/空白不同」的重复问题
DEDUPE=true

# API 服务
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 限流：**每个端点**每个 IP 每分钟最多几个请求；0 = 关闭限流。
# 注意是「每个端点」而不是全站 —— /api/chat 与 /api/agent 各算各的。
# 默认 120：评估脚本会从本机连发 74 个 /api/search 请求，30 会把那条流程自己卡住。
RATE_LIMIT_PER_MINUTE=120
